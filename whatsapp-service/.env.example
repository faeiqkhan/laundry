# WhatsApp service configuration
# Copy to .env-equivalent or set in the environment. Never commit real values.

# HTTP port & bind host (internal service - keep on loopback unless remote)
PORT=3001
HOST=127.0.0.1

# Shared secret the Spring Boot backend must send as `X-Internal-Token`.
# Leave empty to disable the token check (NOT recommended).
WHATSAPP_SERVICE_TOKEN=

# Session persistence (WhatsApp Web login survives restarts).
WHATSAPP_SESSION_PATH=./whatsapp-session

# Local cache for the WhatsApp Web client version (avoids re-downloads).
WHATSAPP_WEB_CACHE_PATH=./whatsapp-web-cache

# Optional path to a Chrome/Chromium/Edge executable (skips Puppeteer's download).
WHATSAPP_PUPPETEER_EXECUTABLE_PATH=

# Run the managed browser headless.
WHATSAPP_HEADLESS=true

# Default phone country (IN = dialing code 91). Used by the central normalizer.
WHATSAPP_DEFAULT_COUNTRY=IN